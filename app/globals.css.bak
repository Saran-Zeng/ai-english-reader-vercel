* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

html {
  background: #f7f8fb;
}

body {
  background: #f7f8fb;
  color: #172033;
  font-family:
    Arial,
    Helvetica,
    sans-serif;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
}

.app-shell {
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f8fb;
}

.header {
  position: relative;
  z-index: 10;

  width: 100%;
  height: 64px;
  flex-shrink: 0;

  display: flex;
  align-items: center;

  padding: 0 24px;

  background: #ffffff;
  border-bottom: 1px solid #e8eaf0;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #20232d;

  font-size: 17px;
  font-weight: 900;
}

.logo-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 34px;
  height: 34px;

  border-radius: 10px;

  background: #6366f1;
  color: #ffffff;

  font-size: 11px;
  font-weight: 900;
}

.app-body {
  width: 100%;
  min-height: calc(100vh - 64px);

  display: flex;
  flex-direction: row;
  align-items: stretch;

  flex: 1;

  overflow: hidden;
}

.main-content {
  flex: 1 1 auto;

  min-width: 0;
  min-height: calc(100vh - 64px);

  padding: 0;

  overflow-x: hidden;
  overflow-y: auto;

  background: #f7f8fb;
}

/* =========================================================
   Common page container
   ========================================================= */

.page-container {
  width: 100%;
  max-width: 1400px;

  margin: 0 auto;

  padding: 32px 36px 60px;
}

.page-header {
  margin-bottom: 28px;
}

.page-title {
  margin: 0;

  color: #172033;

  font-size: 28px;
  line-height: 1.25;
  font-weight: 900;
}

.page-description {
  margin: 8px 0 0;

  color: #8a909d;

  font-size: 13px;
  line-height: 1.7;
}

/* =========================================================
   Cards
   ========================================================= */

.card {
  background: #ffffff;

  border: 1px solid #e8eaf0;
  border-radius: 16px;

  box-shadow:
    0 4px 20px rgba(20, 25, 40, 0.04);
}

/* =========================================================
   Word modal
   ========================================================= */

.word-modal-overlay {
  position: fixed;

  inset: 0;

  z-index: 1000;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(15, 23, 42, 0.42);
}

.word-modal {
  position: relative;

  width: min(420px, 100%);

  background: #ffffff;

  border-radius: 20px;

  padding: 30px;

  box-shadow:
    0 25px 70px rgba(15, 23, 42, 0.2);
}

.word-modal-close {
  position: absolute;

  top: 12px;
  right: 14px;

  border: 0;

  background: transparent;

  color: #64748b;

  font-size: 24px;

  cursor: pointer;
}

.word-modal-word {
  color: #2563eb;

  font-size: 28px;

  font-weight: 900;

  margin-bottom: 10px;
}

.word-modal-meaning {
  color: #172033;

  font-size: 18px;

  font-weight: 700;
}

/* =========================================================
   Responsive
   ========================================================= */

@media (max-width: 800px) {
  .app-body {
    flex-direction: column;

    overflow: visible;
  }

  .main-content {
    min-height: auto;

    overflow: visible;
  }

  .page-container {
    padding: 24px 18px 50px;
  }

  .page-title {
    font-size: 24px;
  }
}/* =========================================================
   AI English Reader - Home Page
   ========================================================= */

.home-page {
  width: 100%;
  min-height: 100%;
  padding: 56px 48px 70px;
}

.home-hero {
  width: 100%;
  max-width: 920px;
  margin: 0 auto;
  text-align: center;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 7px 14px;

  border-radius: 999px;

  background: #eef2ff;
  border: 1px solid #e0e7ff;

  color: #4f46e5;

  font-size: 12px;
  font-weight: 800;
}

.home-hero h1 {
  margin: 20px 0 0;

  color: #172033;

  font-size: clamp(38px, 5vw, 60px);
  line-height: 1.15;

  font-weight: 900;
  letter-spacing: -0.04em;
}

.home-hero h1 span {
  color: #6366f1;
}

.home-hero p {
  width: 100%;
  max-width: 680px;

  margin: 22px auto 0;

  color: #707887;

  font-size: 16px;
  line-height: 1.9;
}


/* =========================================================
   2 × 2 Feature Grid
   ========================================================= */

.feature-section {
  width: 100%;

  display: flex;
  justify-content: center;

  margin-top: 52px;
}

.feature-grid {
  width: min(900px, 100%);

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 22px;
}

.feature-card {
  min-height: 245px;

  display: flex;
  flex-direction: column;

  padding: 30px;

  border-radius: 24px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  box-shadow:
    0 8px 30px rgba(15, 23, 42, 0.05);

  text-decoration: none;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.feature-card:hover {
  transform: translateY(-4px);

  border-color: #c7d2fe;

  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.1);
}

.feature-icon {
  width: 56px;
  height: 56px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 16px;

  background: #f5f7ff;

  font-size: 27px;
}

.feature-card h2 {
  margin: 22px 0 0;

  color: #172033;

  font-size: 21px;
  font-weight: 900;
}

.feature-card p {
  margin: 10px 0 0;

  color: #737b8b;

  font-size: 14px;
  line-height: 1.8;
}

.feature-action {
  margin-top: auto;
  padding-top: 24px;

  color: #4f46e5;

  font-size: 14px;
  font-weight: 800;
}


/* =========================================================
   Reading Flow
   ========================================================= */

.reading-flow {
  width: calc(100% + 96px);

  margin-left: -48px;

  margin-top: 72px;

  padding: 64px 48px;

  background: #ffffff;

  border-top: 1px solid #e8eaf0;
  border-bottom: 1px solid #e8eaf0;
}

.flow-inner {
  width: min(1000px, 100%);

  margin: 0 auto;
}

.flow-header {
  text-align: center;
}

.flow-label {
  color: #6366f1;

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 0.2em;
}

.flow-header h2 {
  margin: 12px 0 0;

  color: #172033;

  font-size: 28px;
  font-weight: 900;
}

.steps {
  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 40px;

  margin-top: 48px;
}

.step {
  text-align: center;
}

.step-number {
  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto;

  border-radius: 50%;

  background: #6366f1;

  color: #ffffff;

  font-size: 12px;
  font-weight: 900;
}

.step h3 {
  margin: 18px 0 0;

  color: #172033;

  font-size: 16px;
  font-weight: 900;
}

.step p {
  max-width: 270px;

  margin: 8px auto 0;

  color: #7b8392;

  font-size: 13px;
  line-height: 1.8;
}


/* =========================================================
   Footer
   ========================================================= */

.home-footer {
  width: min(1000px, 100%);

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin: 0 auto;

  padding-top: 32px;

  color: #9aa1ad;

  font-size: 12px;
}

.home-footer div {
  display: flex;

  gap: 22px;
}

.home-footer a {
  color: #8b93a1;

  text-decoration: none;
}

.home-footer a:hover {
  color: #4f46e5;
}


/* =========================================================
   Home Responsive
   ========================================================= */

@media (max-width: 900px) {
  .home-page {
    padding: 42px 28px 60px;
  }

  .reading-flow {
    width: calc(100% + 56px);
    margin-left: -28px;

    padding-left: 28px;
    padding-right: 28px;
  }
}

@media (max-width: 680px) {
  .home-page {
    padding: 32px 18px 50px;
  }

  .home-hero h1 {
    font-size: 38px;
  }

  .home-hero p {
    font-size: 14px;
  }

  .feature-grid {
    grid-template-columns: 1fr;

    gap: 16px;
  }

  .feature-card {
    min-height: 210px;

    padding: 24px;
  }

  .reading-flow {
    width: calc(100% + 36px);
    margin-left: -18px;

    margin-top: 52px;

    padding: 48px 18px;
  }

  .steps {
    grid-template-columns: 1fr;

    gap: 34px;
  }

  .home-footer {
    flex-direction: column;

    align-items: center;

    text-align: center;
  }

  .home-footer div {
    flex-wrap: wrap;
    justify-content: center;
  }
}/* =========================================================
   Long Reading Page
   ========================================================= */

.long-reading-page {
  width: 100%;
  min-height: 100%;

  padding: 52px 48px 70px;
}

/* Hero */

.long-reading-hero {
  width: min(900px, 100%);

  margin: 0 auto;

  text-align: center;
}

.long-reading-badge {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 7px 14px;

  border-radius: 999px;

  background: #fff7ed;

  border: 1px solid #fed7aa;

  color: #c2410c;

  font-size: 12px;
  font-weight: 900;

  letter-spacing: 0.03em;
}

.long-reading-hero h1 {
  margin: 20px 0 0;

  color: #172033;

  font-size: clamp(36px, 5vw, 52px);

  line-height: 1.15;

  font-weight: 900;

  letter-spacing: -0.04em;
}

.long-reading-hero p {
  max-width: 680px;

  margin: 18px auto 0;

  color: #737b8b;

  font-size: 15px;

  line-height: 1.9;
}


/* Content */

.long-reading-content {
  width: min(1000px, 100%);

  margin: 48px auto 0;
}

.reading-list-header {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  margin-bottom: 20px;
}

.reading-list-header h2 {
  margin: 0;

  color: #172033;

  font-size: 22px;

  font-weight: 900;
}

.reading-list-header p {
  margin: 5px 0 0;

  color: #9aa1ad;

  font-size: 13px;
}


/* Article Grid */

.long-reading-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 22px;
}


/* Article Card */

.long-reading-card {
  min-height: 290px;

  display: flex;

  flex-direction: column;

  padding: 26px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 24px;

  box-shadow:
    0 8px 30px rgba(15, 23, 42, 0.05);

  text-decoration: none;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.long-reading-card:hover {
  transform: translateY(-4px);

  border-color: #fed7aa;

  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.1);
}


/* Card top */

.article-card-top {
  display: flex;

  align-items: center;

  justify-content: space-between;
}

.article-card-icon {
  width: 50px;
  height: 50px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background: #fff7ed;

  font-size: 24px;
}

.article-level {
  padding: 5px 10px;

  border-radius: 999px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 11px;

  font-weight: 800;
}


/* Title */

.long-reading-card h3 {
  margin: 20px 0 0;

  color: #172033;

  font-size: 20px;

  line-height: 1.45;

  font-weight: 900;
}


/* Summary */

.article-summary {
  display: -webkit-box;

  overflow: hidden;

  margin: 10px 0 0;

  color: #737b8b;

  font-size: 13px;

  line-height: 1.8;

  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}


/* Meta */

.article-meta {
  display: flex;

  gap: 8px;

  margin-top: 18px;

  color: #9aa1ad;

  font-size: 12px;
}


/* Action */

.article-card-action {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-top: auto;

  padding-top: 22px;

  color: #4f46e5;

  font-size: 13px;

  font-weight: 900;
}

.article-card-action span {
  font-size: 18px;

  transition: transform 0.2s ease;
}

.long-reading-card:hover
.article-card-action span {
  transform: translateX(4px);
}


/* Empty */

.empty-reading {
  width: min(620px, 100%);

  margin: 40px auto 0;

  padding: 60px 30px;

  text-align: center;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 24px;

  box-shadow:
    0 8px 30px rgba(15, 23, 42, 0.05);
}

.empty-icon {
  font-size: 42px;
}

.empty-reading h2 {
  margin: 18px 0 0;

  color: #172033;

  font-size: 22px;

  font-weight: 900;
}

.empty-reading p {
  margin: 10px 0 0;

  color: #7b8392;

  font-size: 14px;
}

.empty-button {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  margin-top: 24px;

  padding: 11px 18px;

  border-radius: 12px;

  background: #6366f1;

  color: #ffffff;

  text-decoration: none;

  font-size: 13px;

  font-weight: 800;

  transition: background 0.2s ease;
}

.empty-button:hover {
  background: #4f46e5;
}


/* Responsive */

@media (max-width: 900px) {
  .long-reading-page {
    padding: 42px 28px 60px;
  }

  .long-reading-grid {
    gap: 16px;
  }
}

@media (max-width: 680px) {
  .long-reading-page {
    padding: 32px 18px 50px;
  }

  .long-reading-grid {
    grid-template-columns: 1fr;
  }

  .long-reading-card {
    min-height: 260px;

    padding: 22px;
  }

  .long-reading-hero h1 {
    font-size: 38px;
  }

  .long-reading-hero p {
    font-size: 14px;
  }
}/* =========================================================
   Long Reading Detail
   独立控制长篇阅读详情页，不影响其他页面
   ========================================================= */

.long-reading-detail-page {
  width: 100%;
  min-height: 100vh;
}

.long-reading-content {
  width: min(
    calc(100% - 48px),
    1100px
  );

  margin-left: auto;
  margin-right: auto;

  padding-top: 48px;
  padding-bottom: 80px;
}

@media (max-width: 900px) {
  .long-reading-content {
    width: calc(100% - 36px);
    padding-top: 32px;
    padding-bottom: 60px;
  }
}

@media (max-width: 600px) {
  .long-reading-content {
    width: calc(100% - 24px);
    padding-top: 24px;
    padding-bottom: 48px;
  }
}
