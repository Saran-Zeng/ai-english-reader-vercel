"use client";

import Link from "next/link";
import { useEffect, useMemo, useRef, useState } from "react";

type Word = {
  id: string;
  word: string;
  meaning: string | null;
};

type Sentence = {
  id: string;
  english: string;
  translation: string | null;
  order: number;
  words?: Word[];
};

type Article = {
  id: string;
  title: string;
  subtitle?: string | null;
  content: string;
  translation: string | null;
  summary?: string | null;
  level?: string | null;
  category?: string | null;
  sentences: Sentence[];
};

type AudioState = {
  found: boolean;
  audioUrl: string | null;
  fileName?: string;
};

type Props = {
  params: Promise<{
    id: string;
  }>;
};

export default function LongReadingDetailPage({ params }: Props) {
  const [articleId, setArticleId] = useState<string | null>(null);
  const [article, setArticle] = useState<Article | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    let cancelled = false;

    params.then(({ id }) => {
      if (!cancelled) {
        setArticleId(id);
      }
    });

    return () => {
      cancelled = true;
    };
  }, [params]);

  useEffect(() => {
    if (!articleId) return;

    let cancelled = false;

    async function loadArticle() {
      try {
        setLoading(true);
        setError("");

        const response = await fetch(`/api/articles/${articleId}`, {
          cache: "no-store",
        });

        if (!response.ok) {
          throw new Error("文章不存在");
        }

        const data = await response.json();

        const rawArticle = data?.article ?? data;

        if (!rawArticle?.id) {
          throw new Error("文章数据为空");
        }

        const normalized: Article = {
          id: rawArticle.id,
          title: rawArticle.title ?? "Untitled Article",
          subtitle: rawArticle.subtitle ?? null,
          content: rawArticle.content ?? "",
          translation: rawArticle.translation ?? null,
          summary: rawArticle.summary ?? null,
          level: rawArticle.level ?? null,
          category: rawArticle.category ?? null,
          sentences: Array.isArray(rawArticle.sentences)
            ? rawArticle.sentences
                .map((sentence: Sentence) => ({
                  id: sentence.id,
                  english: sentence.english ?? "",
                  translation: sentence.translation ?? null,
                  order: sentence.order ?? 0,
                  words: Array.isArray(sentence.words)
                    ? sentence.words
                    : [],
                }))
                .sort((a: Sentence, b: Sentence) => a.order - b.order)
            : [],
        };

        if (!cancelled) {
          setArticle(normalized);
        }
      } catch (err) {
        console.error(err);

        if (!cancelled) {
          setError("文章不存在，或者文章数据读取失败。");
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    loadArticle();

    return () => {
      cancelled = true;
    };
  }, [articleId]);

  if (loading) {
    return (
      <main className="min-h-screen bg-slate-50">
        <section className="mx-auto max-w-4xl px-6 py-20">
          <div className="rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-sm">
            <div className="text-sm text-slate-500">
              正在加载文章...
            </div>
          </div>
        </section>
      </main>
    );
  }

  if (error || !article) {
    return (
      <main className="min-h-screen bg-slate-50">
        <section className="mx-auto max-w-4xl px-6 py-20">
          <div className="rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-sm">
            <div className="text-4xl">📚</div>

            <h1 className="mt-5 text-2xl font-bold text-slate-900">
              文章不存在
            </h1>

            <p className="mt-3 text-sm text-slate-500">
              这篇文章可能已经被删除，或者文章数据还没有正确保存。
            </p>

            <Link
              href="/long-reading"
              className="mt-7 inline-block rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700"
            >
              返回长篇阅读
            </Link>
          </div>
        </section>
      </main>
    );
  }

  return <ReadingInterface article={article} />;
}

function ReadingInterface({
  article,
}: {
  article: Article;
}) {
  const [showChinese, setShowChinese] = useState(true);
  const [showFullTranslation, setShowFullTranslation] = useState(false);

  const [playing, setPlaying] = useState(false);
  const [currentParagraph, setCurrentParagraph] = useState<number | null>(
    null,
  );

  const [audio, setAudio] = useState<AudioState>({
    found: false,
    audioUrl: null,
  });

  const [audioLoading, setAudioLoading] = useState(false);

  const [localAudioUrl, setLocalAudioUrl] = useState<string | null>(null);
  const [localAudioName, setLocalAudioName] = useState("");

  const audioRef = useRef<HTMLAudioElement | null>(null);

  /*
   * =========================================================
   * 自动寻找文章原声音频
   * =========================================================
   */
  useEffect(() => {
    let cancelled = false;

    async function findAudio() {
      try {
        setAudioLoading(true);

        const query = new URLSearchParams({
          id: article.id,
          title: article.title,
        });

        const response = await fetch(
          `/api/audio-match?${query.toString()}`,
          {
            cache: "no-store",
          },
        );

        if (!response.ok) {
          return;
        }

        const data = await response.json();

        if (!cancelled) {
          setAudio({
            found: Boolean(data?.found),
            audioUrl: data?.audioUrl ?? null,
            fileName: data?.fileName ?? "",
          });
        }
      } catch (error) {
        console.error("Audio lookup failed:", error);
      } finally {
        if (!cancelled) {
          setAudioLoading(false);
        }
      }
    }

    findAudio();

    return () => {
      cancelled = true;
    };
  }, [article.id, article.title]);

  /*
   * =========================================================
   * 本地导入音频
   * =========================================================
   */
  function handleAudioImport(
    event: React.ChangeEvent<HTMLInputElement>,
  ) {
    const file = event.target.files?.[0];

    if (!file) return;

    if (!file.type.startsWith("audio/")) {
      alert("请选择 MP3、WAV、M4A、OGG 等音频文件。");
      return;
    }

    if (localAudioUrl) {
      URL.revokeObjectURL(localAudioUrl);
    }

    const url = URL.createObjectURL(file);

    setLocalAudioUrl(url);
    setLocalAudioName(file.name);
  }

  /*
   * =========================================================
   * 浏览器语音朗读
   * =========================================================
   */
  function stopSpeaking() {
    if (typeof window !== "undefined") {
      window.speechSynthesis.cancel();
    }

    setPlaying(false);
    setCurrentParagraph(null);
  }

  function speakParagraph(index: number) {
    if (typeof window === "undefined") return;

    const paragraph = article.sentences[index];

    if (!paragraph) return;

    window.speechSynthesis.cancel();

    const utterance = new SpeechSynthesisUtterance(
      paragraph.english,
    );

    utterance.lang = "en-US";
    utterance.rate = 0.9;
    utterance.pitch = 1;

    utterance.onstart = () => {
      setPlaying(true);
      setCurrentParagraph(index);
    };

    utterance.onend = () => {
      setPlaying(false);
      setCurrentParagraph(null);
    };

    utterance.onerror = () => {
      setPlaying(false);
      setCurrentParagraph(null);
    };

    window.speechSynthesis.speak(utterance);
  }

  function speakAll() {
    if (typeof window === "undefined") return;

    if (article.sentences.length === 0) {
      const text = article.content.trim();

      if (!text) return;

      window.speechSynthesis.cancel();

      const utterance = new SpeechSynthesisUtterance(text);

      utterance.lang = "en-US";
      utterance.rate = 0.9;

      utterance.onstart = () => {
        setPlaying(true);
        setCurrentParagraph(null);
      };

      utterance.onend = () => {
        setPlaying(false);
        setCurrentParagraph(null);
      };

      utterance.onerror = () => {
        setPlaying(false);
        setCurrentParagraph(null);
      };

      window.speechSynthesis.speak(utterance);

      return;
    }

    window.speechSynthesis.cancel();

    const text = article.sentences
      .map((sentence) => sentence.english)
      .join("\n\n");

    const utterance = new SpeechSynthesisUtterance(text);

    utterance.lang = "en-US";
    utterance.rate = 0.9;
    utterance.pitch = 1;

    utterance.onstart = () => {
      setPlaying(true);
      setCurrentParagraph(0);
    };

    utterance.onend = () => {
      setPlaying(false);
      setCurrentParagraph(null);
    };

    utterance.onerror = () => {
      setPlaying(false);
      setCurrentParagraph(null);
    };

    window.speechSynthesis.speak(utterance);
  }

  /*
   * =========================================================
   * AI TTS
   * =========================================================
   */
  async function speakWithAI(text: string, index?: number) {
    try {
      if (typeof window !== "undefined") {
        window.speechSynthesis.cancel();
      }

      setPlaying(true);

      if (index !== undefined) {
        setCurrentParagraph(index);
      }

      const response = await fetch("/api/tts", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          text,
          voice: "nova",
          speed: 0.9,
        }),
      });

      if (!response.ok) {
        const data = await response.json().catch(() => null);

        throw new Error(
          data?.error || "AI 朗读失败",
        );
      }

      const blob = await response.blob();

      const url = URL.createObjectURL(blob);

      const audioElement = new Audio(url);

      audioRef.current = audioElement;

      audioElement.onended = () => {
        URL.revokeObjectURL(url);
        setPlaying(false);
        setCurrentParagraph(null);
        audioRef.current = null;
      };

      audioElement.onerror = () => {
        URL.revokeObjectURL(url);
        setPlaying(false);
        setCurrentParagraph(null);
        audioRef.current = null;
      };

      await audioElement.play();
    } catch (error) {
      console.error(error);

      setPlaying(false);
      setCurrentParagraph(null);

      alert(
        error instanceof Error
          ? error.message
          : "AI 朗读失败，请检查 OpenAI API 配置。",
      );
    }
  }

  function stopAllAudio() {
    stopSpeaking();

    if (audioRef.current) {
      audioRef.current.pause();
      audioRef.current.currentTime = 0;
      audioRef.current = null;
    }
  }

  /*
   * =========================================================
   * 统计
   * =========================================================
   */
  const wordCount = useMemo(() => {
    if (article.sentences.length > 0) {
      return article.sentences.reduce(
        (total, sentence) => {
          return (
            total +
            sentence.english
              .trim()
              .split(/\s+/)
              .filter(Boolean).length
          );
        },
        0,
      );
    }

    return article.content
      .trim()
      .split(/\s+/)
      .filter(Boolean).length;
  }, [article]);

  const paragraphs = useMemo(() => {
    if (article.sentences.length > 0) {
      return article.sentences;
    }

    const blocks = article.content
      .split(/\n+/)
      .map((value) => value.trim())
      .filter(Boolean);

    return blocks.map((english, index) => ({
      id: `paragraph-${index}`,
      english,
      translation: null,
      order: index,
      words: [],
    }));
  }, [article]);

  const fullAudioUrl =
    localAudioUrl || audio.audioUrl || null;

  return (
    <main className="min-h-screen bg-slate-50">
      <header className="sticky top-0 z-30 border-b bg-white/95 backdrop-blur">
        <div className="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
          <Link
            href="/long-reading"
            className="font-semibold text-slate-700 hover:text-blue-600"
          >
            ← 长篇阅读
          </Link>

          <Link
            href="/"
            className="font-bold text-slate-900"
          >
            AI English Reader
          </Link>

          <Link
            href="/reader"
            className="font-semibold text-blue-600"
          >
            AI 阅读
          </Link>
        </div>
      </header>

      <section className="mx-auto max-w-4xl px-6 py-12">
        {/* =====================================================
            文章头部
           ===================================================== */}
        <div className="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm md:p-12">
          <div className="flex flex-wrap gap-2">
            {article.level && (
              <span className="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">
                {article.level}
              </span>
            )}

            {article.category && (
              <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                {article.category}
              </span>
            )}

            <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
              {paragraphs.length} 段
            </span>

            <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
              约 {wordCount} 词
            </span>
          </div>

          <h1 className="mt-6 text-4xl font-bold leading-tight text-slate-900 md:text-5xl">
            {article.title}
          </h1>

          {article.subtitle && (
            <p className="mt-4 text-xl text-slate-500">
              {article.subtitle}
            </p>
          )}

          {article.summary && (
            <div className="mt-7 rounded-2xl bg-slate-50 p-5">
              <div className="mb-2 text-xs font-bold uppercase tracking-wider text-slate-400">
                Article Summary
              </div>

              <p className="text-sm leading-7 text-slate-600">
                {article.summary}
              </p>
            </div>
          )}

          {/* ===================================================
              操作区
             =================================================== */}
          <div className="mt-10 flex flex-wrap gap-3 border-t pt-8">
            <button
              onClick={speakAll}
              className="rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white transition hover:bg-blue-700"
            >
              🔊 全文朗读
            </button>

            <button
              onClick={stopAllAudio}
              disabled={!playing}
              className="rounded-xl border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40"
            >
              ⏹ 停止朗读
            </button>

            <button
              onClick={() =>
                setShowChinese((value) => !value)
              }
              className="rounded-xl border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:bg-slate-50"
            >
              {showChinese
                ? "🙈 隐藏中文"
                : "👀 显示中文"}
            </button>

            {article.translation && (
              <button
                onClick={() =>
                  setShowFullTranslation(
                    (value) => !value,
                  )
                }
                className="rounded-xl border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:bg-slate-50"
              >
                {showFullTranslation
                  ? "隐藏全文翻译"
                  : "显示全文翻译"}
              </button>
            )}
          </div>

          {/* ===================================================
              原声音频
             =================================================== */}
          <div className="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div className="flex flex-col gap-4">
              <div>
                <div className="font-bold text-slate-800">
                  🎧 原声音频
                </div>

                <div className="mt-1 text-xs leading-6 text-slate-500">
                  {audioLoading
                    ? "正在寻找与文章匹配的音频..."
                    : audio.found
                      ? `已匹配：${audio.fileName}`
                      : "没有自动找到匹配音频，可以手动导入。"}
                </div>
              </div>

              {fullAudioUrl && (
                <audio
                  controls
                  src={fullAudioUrl}
                  className="w-full"
                />
              )}

              <div className="flex flex-wrap items-center gap-3">
                <label className="inline-flex cursor-pointer items-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                  📁 导入音频
                  <input
                    type="file"
                    accept="audio/*"
                    onChange={handleAudioImport}
                    className="hidden"
                  />
                </label>

                {localAudioName && (
                  <span className="text-xs text-slate-500">
                    已导入：{localAudioName}
                  </span>
                )}
              </div>
            </div>
          </div>

          {playing && (
            <div className="mt-5 rounded-xl bg-blue-50 px-4 py-3 text-sm font-medium text-blue-700">
              🔊 正在朗读
              {currentParagraph !== null
                ? ` · 第 ${currentParagraph + 1} 段`
                : ""}
            </div>
          )}

          {/* ===================================================
              全文中文翻译
             =================================================== */}
          {showFullTranslation &&
            article.translation && (
              <div className="mt-6 rounded-2xl border border-amber-100 bg-amber-50 p-5">
                <div className="mb-2 text-xs font-bold uppercase tracking-wider text-amber-600">
                  Full Translation
                </div>

                <p className="text-base leading-8 text-slate-700">
                  {article.translation}
                </p>
              </div>
            )}
        </div>

        {/* =====================================================
            正文
           ===================================================== */}
        <div className="mt-8 space-y-5">
          {paragraphs.map((paragraph, index) => {
            const active =
              currentParagraph === index;

            return (
              <article
                key={paragraph.id}
                className={`rounded-2xl border bg-white p-6 shadow-sm transition md:p-8 ${
                  active
                    ? "border-blue-400 ring-2 ring-blue-100"
                    : "border-slate-200"
                }`}
              >
                <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
                  <span className="flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-500">
                    {index + 1}
                  </span>

                  <div className="flex flex-wrap gap-2">
                    <button
                      onClick={() =>
                        speakParagraph(index)
                      }
                      className="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50"
                    >
                      🔊 朗读本段
                    </button>

                    <button
                      onClick={() =>
                        speakWithAI(
                          paragraph.english,
                          index,
                        )
                      }
                      className="rounded-lg bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100"
                    >
                      🤖 AI朗读
                    </button>
                  </div>
                </div>

                {/* 英文 */}
                <p className="text-xl font-medium leading-9 text-slate-900">
                  {paragraph.english}
                </p>

                <div className="my-6 border-t border-dashed border-slate-200" />

                {/* 中文 */}
                {showChinese ? (
                  paragraph.translation ? (
                    <div>
                      <div className="mb-2 text-xs font-bold text-slate-400">
                        中文翻译
                      </div>

                      <p className="text-base leading-8 text-slate-600">
                        {paragraph.translation}
                      </p>
                    </div>
                  ) : (
                    <div className="rounded-xl bg-slate-50 px-4 py-4 text-sm text-slate-400">
                      本段暂无中文翻译
                    </div>
                  )
                ) : (
                  <div className="rounded-xl bg-slate-50 px-4 py-4 text-sm text-slate-400">
                    中文已隐藏
                  </div>
                )}
              </article>
            );
          })}
        </div>

        {/* =====================================================
            文章结束
           ===================================================== */}
        <div className="mt-10 rounded-2xl border border-slate-200 bg-white p-6 text-center">
          <p className="text-sm text-slate-500">
            已完成本文阅读
          </p>

          <Link
            href="/long-reading"
            className="mt-4 inline-block rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white hover:bg-slate-800"
          >
            阅读其他文章
          </Link>
        </div>
      </section>
    </main>
  );
}